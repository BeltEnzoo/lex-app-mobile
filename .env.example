# Ejemplo de variables (copiá a .env en local; en hosting cargalas en el panel)

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
API_PORT=8787

# Solo local / emulador. En builds de Play Store se define en eas.json
EXPO_PUBLIC_API_URL=http://localhost:8787

# Producción (Render):
# EXPO_PUBLIC_API_URL=https://lex-app-mobile.onrender.com

# Avisos de solicitudes (SendGrid — HTTPS, funciona en Render)
SENDGRID_API_KEY=SG.xxxxxxxx
# Remitente verificado en SendGrid (Single Sender Verification)
SENDGRID_FROM_EMAIL=on.kode.soluciones@gmail.com
SENDGRID_FROM_NAME=Lex CardioSegura
ZONE_REQUEST_NOTIFY_EMAIL=info@lexserviciosintegrales.com
