# Ejemplo de variables (copiá a .env en local; en hosting cargalas en el panel)

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
API_PORT=8787

# Solo local / emulador. En builds de Play Store se define en eas.json
EXPO_PUBLIC_API_URL=http://localhost:8787

# Producción (Render):
# EXPO_PUBLIC_API_URL=https://lex-app-mobile.onrender.com

# Avisos de solicitudes (Web3Forms — gratis, HTTPS, funciona en Render)
# Crear key en https://web3forms.com con el mail de Martín
WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
