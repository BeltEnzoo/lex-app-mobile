# Ejemplo de variables (copiá a .env en local; en hosting cargalas en el panel)

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
API_PORT=8787

# Solo local / emulador. En builds de Play Store se define en eas.json
EXPO_PUBLIC_API_URL=http://localhost:8787

# Producción (Render):
# EXPO_PUBLIC_API_URL=https://lex-app-mobile.onrender.com

# Avisos de solicitudes por Gmail
GMAIL_USER=tu-cuenta@gmail.com
# Contraseña de aplicación (16 caracteres), no la clave normal de Gmail
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
ZONE_REQUEST_NOTIFY_EMAIL=info@lexserviciosintegrales.com
GMAIL_FROM_NAME=Lex CardioSegura
