{
  "expo": {
    "name": "Lex CardioSegura",
    "slug": "lex-cardiosegura",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lexcardiosegura",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0047AB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lex.cardiosegura",
      "config": {
        "googleMapsApiKey": "YOUR_IOS_GOOGLE_MAPS_API_KEY"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Lex CardioSegura usa tu ubicación para mostrarte el DEA y la zona cardio-segura más cercana."
      }
    },
    "android": {
      "package": "com.lex.cardiosegura",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0047AB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCwaaJIPij7w0SaYIPvYhSovJWYSHwXDd8"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir a Lex CardioSegura usar tu ubicación para encontrar DEAs cercanos."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "547b4147-4ffb-4151-a0d5-dabb56f311b8"
      }
    },
    "owner": "kodeonsolucioness-organization"
  }
}
